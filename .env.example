# Example environment for local development.
# Copy to .env (git-ignored) and fill in the secrets. The repository is public:
# never put real secrets in this file.
#
# Docker Compose reads .env by itself. Go does not: export the BOOKIT_* variables
# of the application in your shell (or in the IDE run configuration), e.g.
#   set -a; . ./.env; set +a; go run ./cmd/bookit

# --- Application ---------------------------------------------------------
# dev | prod  (prod switches logs to JSON)
BOOKIT_ENV=dev

# Address the HTTP server listens on.
BOOKIT_HTTP_ADDR=:8080

# debug | info | warn | error
BOOKIT_LOG_LEVEL=info

# PostgreSQL connection 
BOOKIT_DATABASE_URL=postgres

# Maximum number of pooled connections (default 10).
BOOKIT_DB_MAX_CONNS=10

# SECRET: key that signs access tokens (required, at least 32 bytes). Generate:
#   openssl rand -base64 48
BOOKIT_JWT_SECRET=

# Secret rotation: move the old value here and put a new one above; tokens signed
# with the old secret stay valid until they expire (15 minutes). Remove it after.
# BOOKIT_JWT_SECRET_PREVIOUS=

# true in EVERY deployed environment (dev included): the server then refuses plain
# HTTP requests (it trusts X-Forwarded-Proto from the TLS-terminating proxy in front)
# and sends HSTS. Leave false only when running on your own machine.
BOOKIT_REQUIRE_HTTPS=false

# --- Docker Compose (local PostgreSQL) -----------------------------------
BOOKIT_DB_USER=bookit
BOOKIT_DB_NAME=bookit

# SECRET: choose a password (Compose refuses to start while it is empty).
# Changing it later requires `docker compose down -v` (it is stored in the volume).
BOOKIT_DB_PASSWORD=

# Host port of the local database (5432-5434 are often taken by other projects).
BOOKIT_DB_PORT=5440
